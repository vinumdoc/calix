{
	"name": "calix",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "paraglide-js compile && vite dev",
		"build": "paraglide-js compile && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:sync": "./scripts/db-sync.sh",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"auth:generate": "pnpm dlx @better-auth/cli@latest generate --output src/lib/server/db/auth_schema.ts"
	},
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.35.0",
		"@internationalized/date": "^3.10.0",
		"@lezer/generator": "^1.8.0",
		"@lucide/svelte": "^0.544.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@playwright/test": "^1.55.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.48.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"@types/ws": "^8.18.1",
		"better-auth": "^1.4.1",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.6",
		"drizzle-orm": "^0.44.5",
		"eslint": "^9.35.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.3",
		"globals": "^16.4.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.43.1",
		"svelte-check": "^4.3.3",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.13",
		"tw-animate-css": "^1.3.8",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.43.0",
		"valibot": "^1.1.0",
		"vite": "^7.1.12",
		"vitest": "^4.0.5"
	},
	"dependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/language": "^6.11.3",
		"@codemirror/lint": "^6.8.5",
		"@codemirror/search": "^6.5.11",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.2",
		"@inlang/paraglide-js": "^2.3.2",
		"@lezer/highlight": "^1.2.1",
		"@lezer/lr": "^1.4.2",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"codemirror": "^6.0.2",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.44.7",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.7",
		"ws": "^8.21.1",
		"y-codemirror.next": "^0.3.5",
		"y-websocket": "^1.5.4",
		"yjs": "^13.6.31"
	},
	"packageManager": "pnpm@10.20.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild"
		]
	}
}