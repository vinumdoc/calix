# Auth Configuration
# You can generate your own secret using openssl
BETTER_AUTH_SECRET=generate_your_own_secret

# Base URL used by the authentication service
# needs to be set both in development and production
BETTER_AUTH_URL=http://localhost:3000 
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database Configuration
DATABASE_URL="postgresql://calix_user:calix_password@db:5432/calix_db"
POSTGRES_USER=calix_user
POSTGRES_PASSWORD=calix_password

# Vinumc Configuration
# Set to 'release' to use the pre-built binary from GitHub releases
# Set to 'local' to use a locally built binary (requires VINUMC_PATH)
VINUMC_SOURCE=release

# Vinumc Release Version (used when VINUMC_SOURCE=release)
VINUMC_VERSION=vinumc-v0.1.0-alpha

# Local Vinumc Path (used when VINUMC_SOURCE=local)
# This should point to your locally built vinumc binary
VINUMC_PATH=/path/to/your/vinumc

## Development Configuration
NODE_ENV=development

## Production Configuration
# All of these variables need to be set in the production environment

# The origin needs to match the URL where your app is hosted.
# If you are usig { trustedOrigins: ['*'] } in svelte.config.js,
# any valid URL will work, but ORIGIN must have a valid URL.
ORIGIN=https://vinumdoc.example.com:3000

# The port the container will listen on
# Does not affect the port used during development
HOST_PORT=3000
