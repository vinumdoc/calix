# ==============================================================================
# Vinum Online (Calix) Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication (Better Auth & OAuth Providers)
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies and tokens (generate with `openssl rand -hex 32`)
BETTER_AUTH_SECRET=generate_your_own_secret

# Base URL for auth callbacks (must match public protocol and host)
# Development: http://localhost:5173 (or http://localhost:3000 in production container)
PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:5173
PUBLIC_BETTER_AUTH_BASE_PATH=/api/auth

# OAuth 2.0 Credentials (Optional: Leave blank to disable individual providers)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL & Drizzle ORM)
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by SvelteKit app and Yjs WebSocket server
# Inside Docker: postgresql://calix_user:calix_password@db:5432/calix_db
# Local Dev:     postgresql://calix_user:calix_password@localhost:5434/calix_db
DATABASE_URL="postgresql://calix_user:calix_password@db:5432/calix_db"

POSTGRES_USER=calix_user
POSTGRES_PASSWORD=calix_password

# ------------------------------------------------------------------------------
# 3. Vinum Typesetting Compiler (vinumc)
# ------------------------------------------------------------------------------
# Compiler source mode:
# - 'release': Downloads and installs pre-built binary from GitHub release assets
# - 'local': Mounts a locally compiled vinumc binary (requires VINUMC_PATH)
VINUMC_SOURCE=release

# GitHub release tag to download when VINUMC_SOURCE=release
VINUMC_VERSION=vinumc-v0.1.0-alpha

# Absolute path to local vinumc binary when VINUMC_SOURCE=local
VINUMC_PATH=/path/to/your/vinumc

# ------------------------------------------------------------------------------
# 4. Realtime Collaboration (Yjs CRDT & WebSockets)
# ------------------------------------------------------------------------------
# WebSocket Server Port (used by scripts/y-websocket-server.js)
YJS_WS_PORT=1234

# Client-accessible WebSocket URL for CodeMirror 6 Yjs CRDT real-time sync
# Development: ws://localhost:1234
# Production:  wss://yourdomain.com/ws (or ws://yourdomain.com:1234)
PUBLIC_YJS_WS_URL=ws://localhost:1234

# ------------------------------------------------------------------------------
# 5. Server & Deployment Options
# ------------------------------------------------------------------------------
# Environment mode ('development' or 'production')
NODE_ENV=development

# Production app origin URL (required by SvelteKit Node adapter for CSRF protection)
ORIGIN=https://vinumdoc.example.com

# Host port exposed by Docker Compose in production mode
HOST_PORT=3000
