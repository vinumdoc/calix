@top File { statement* }

@skip { space }


statement {
  String |
  Text |
  DryDefinition |
  DryGlobalDefinition |
  DryCall |
  DryComment |
  SweetCall |
  GroupSweetCall |
  ChildrenShot |
  "(" ~sweetParen |
  ")" |
  "."
}

Body {
  statement*
}

ChildrenShot {
  "$*"
}


DryDefinition {
  "[" Identifier? DeclMarker Body "]"
}

DryCall {
  "[" Identifier Body "]"
}

DryGlobalDefinition {
  "[" Identifier GlobalDeclMarker Body "]"
}

DryComment {
  "[" "#" commentContent* "]"
}

SweetCall {
  "." Identifier
}

GroupSweetCall {
  "(" ~sweetParen Body ")." Identifier
}

@skip {} {
  String {
    "{#" stringContent* stringEnd
  }
}

@local tokens {
  stringEnd { "#}" }
  @else stringContent
}

@external tokens textTokenizer from "./tokens" { Text, DeclMarker, GlobalDeclMarker }

@tokens {
  commentContent { ![\]] }
  textChar { ![\n] }
  space { @whitespace+ }
  Identifier { $[A-Za-z_] $[A-Za-z0-9_]* }

  @precedence {
    commentContent,
    space,
    "(",
    ".",
    "[",
    "]"
  }

  "[" "]" "(" ")" ")." "#"
}

@external propSource highlighting from "./highlight.js"
